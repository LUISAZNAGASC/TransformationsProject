bool VectorTwo::operator==(const VectorTwo& otherVectorTwo) const noexcept
{
	const bool xComparison = GetXComponent() == otherVectorTwo.GetXComponent();
	const bool yComparison = GetYComponent() == otherVectorTwo.GetYComponent();

	return xComparison && yComparison;
}

bool VectorTwo::operator!=(const VectorTwo& otherVectorTwo) const noexcept
{
	const bool xComparison = GetXComponent() != otherVectorTwo.GetXComponent();
	const bool yComparison = GetYComponent() != otherVectorTwo.GetYComponent();

	return xComparison || yComparison;
}

