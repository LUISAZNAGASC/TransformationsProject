double VectorTwo::GetRealDistance(const VectorTwo& firstVectorTwo, const VectorTwo& secondVectorTwo) noexcept
{
	const double xDifference = firstVectorTwo.GetXComponent() - secondVectorTwo.GetXComponent();
	const double yDifference = firstVectorTwo.GetYComponent() - secondVectorTwo.GetYComponent();

	return std::sqrt(xDifference * xDifference + yDifference * yDifference);
}

double VectorTwo::GetSquaredDistance(const VectorTwo& firstVectorTwo, const VectorTwo& secondVectorTwo) noexcept
{
	const double xDifference = firstVectorTwo.GetXComponent() - secondVectorTwo.GetXComponent();
	const double yDifference = firstVectorTwo.GetYComponent() - secondVectorTwo.GetYComponent();

	return xDifference * xDifference + yDifference * yDifference;
}

double VectorTwo::GetRealMagnitude(const VectorTwo& firstVectorTwo) noexcept
{
	const double xSquared = firstVectorTwo.GetXComponent() * firstVectorTwo.GetXComponent();
	const double ySquared = firstVectorTwo.GetYComponent() * firstVectorTwo.GetYComponent();

	return std::sqrt(xSquared + ySquared);
}

double VectorTwo::GetSquaredMagnitude(const VectorTwo& firstVectorTwo) noexcept
{
	const double xSquared = firstVectorTwo.GetXComponent() * firstVectorTwo.GetXComponent();
	const double ySquared = firstVectorTwo.GetYComponent() * firstVectorTwo.GetYComponent();

	return xSquared + ySquared;
}

VectorTwo VectorTwo::GetClampedMagnitude(const VectorTwo& firstVectorTwo, const double maximumLength) noexcept
{
	const double squaredMagnitude = GetSquaredMagnitude(firstVectorTwo);

	double xComponent;
	double yComponent;

	if (squaredMagnitude > maximumLength * maximumLength)
	{
		const double realMagnitude = GetRealMagnitude(firstVectorTwo);

		const double xNormalized = firstVectorTwo.GetXComponent() / realMagnitude;
		const double yNormalized = firstVectorTwo.GetYComponent() / realMagnitude;

		xComponent = xNormalized * maximumLength;
		yComponent = yNormalized * maximumLength;
	}
	else
	{
		xComponent = firstVectorTwo.GetXComponent();
		yComponent = firstVectorTwo.GetYComponent();
	}

	return VectorTwo(xComponent, yComponent);
}

VectorTwo VectorTwo::GetNormalizedVector(const VectorTwo& firstVectorTwo) noexcept
{
	const float realMagnitude = GetRealMagnitude(firstVectorTwo);

	double xComponent;
	double yComponent;

	if (realMagnitude > 0.0)
	{
		xComponent = firstVectorTwo.GetXComponent() / realMagnitude;
		yComponent = firstVectorTwo.GetYComponent() / realMagnitude;
	}
	else
	{
		xComponent = 0.0;
		yComponent = 0.0;
	}

	return VectorTwo(xComponent, yComponent);
}

double VectorTwo::GetDotProduct(const VectorTwo& firstVectorTwo, const VectorTwo& secondVectorTwo) noexcept
{
	const double xProduct = firstVectorTwo.GetXComponent() * secondVectorTwo.GetXComponent();
	const double yProduct = firstVectorTwo.GetYComponent() * secondVectorTwo.GetYComponent();

	return xProduct + yProduct;
}

